// sometime we want a state of a variable to change when the user has clicked or asked for something, since its applications that the user can interact with
// Not just like the way we have been doing before- where we deliberately change the state of a variable on no grounds
// So we will use event handlers-> event handlers like clicks can trigger change in certain parts of our components, event handlers can be clicks,etc

const App = () => {
  // this is our state
  const [counter, setCounter] = useState(0);
  // register an event handler function-> what we want to happen when an event handler is clicked
  // this is what will be tricked when want a change of state
  const handleClick = () => {
    console.log("clicked");
  };

  return (
    <div>
      <div>{counter}</div>
      {/* the event handler here is the button -> what we want the user to ask or click to do a certain thing on the web */}
      <button onClick={handleClick}>plus</button>
    </div>
  );
};
// NB: Dont include the the handler functions in the JSX because it can become so complex
// So define them outside as independent functions then pass them as values of the attributes on the element you what to trigger the function that you defined!!

const App = () => {
  const [counter, setCounter] = useState(0);

  // 1st handler function that will increment the counter variable
  const increaseByOne = () => setCounter(counter + 1);
  // 2nd handler function that will reset the counter variable to zero(0)
  const setToZero = () => setCounter(0);

  return (
    <div>
      <div>{counter}</div>
      {/* Now pass the 1st function in as the values of the atttributes of the button element*/}
      <button onClick={increaseByOne}>plus</button>
      {/* Now pass the 2nd function in as the values of the attributes of the button element */}
      <button onClick={setToZero}>zero</button>
    </div>
  );
};

// Passing state to CHILD COMPONENTS
3 Components - one Component for displaying counter,2 for button
//  Here there is a concept called lifting up the state- where the state is put inside a shared common ancestor

// componenet for counter
const Display=(props)=>{
  return (
    // this will be passed down onto it as a state from the parent
  <div>{props.counter}
  </div>)
}
// component for button - It makes the component reusable- which we can use for many other things
const Button=({title,whatToDo})=>{
  // things its going to inherit from the parent
  <button onClick={whatToDo}>{title}</button>
}

// representation of passing state to CHILD COMPONENTS
const App = () => {
  // state- lifted up(lift the state up)- shared common ancestor
  // so that child components can use it
  const [ counter, setCounter ] = useState(0)
// This is 1st handler function- increase the variable by 1
  const increaseByOne = () => setCounter(counter + 1)
  // This is 2nd handler function- reset the variable to zero(0)
  const setToZero = () => setCounter(0)

  return (
    <div>
      {/* state is passed down to the child component called DISPLAY in this case */}
      <Display counter={counter}/>
      {/* handler function passed into the event handler-button */}
      <button onClick={increaseByOne}>
        plus
      </button>
      {/* handler function passed into the event handler-button */}
      <button onClick={setToZero}> 
        zero
      </button>
    </div>
  )
}

// NB: When the state changes, the Whole component is re-rendered including its CHILDREN!!

// 🥷✅Changes in state cause re-rendering
// -When Application startTransition, the app is executed
// LETS UNDERSTAND HOW THE APP WORKS!!
const App = () => {
  // The state- or variable that changes
  const [counter, setCounter] = useState(0)
// This message will be display on the browser console
  console.log('rendering with counter value', counter)
  // 1st handler function
  const increaseByOne = () => {

    console.log('increasing, value before', counter)
    setCounter(counter + 1)
  }
// 2nd handler function that decreases the value by 1
  const decreaseByOne = () => { 

    console.log('decreasing, value before', counter)
    setCounter(counter - 1)
  }

  // 3rd handler function to reset the value to zero(0)
  const setToZero = () => {

    console.log('resetting to zero, value before', counter)
    setCounter(0)
  }

  return (
    <div>
      <Display counter={counter} />
      <Button onClick={increaseByOne} text="plus" />
      <Button onClick={setToZero} text="zero" />
      <Button onClick={decreaseByOne} text="minus" />
    </div>
  )
} 

//🥷✅ DEVELOPER TIP: Do not ever try to guess what your code does.
// It is just better to use CONSOLE.LOG and see with your own eyes what it does.
// 1- First code what works, then later you can refactor your components the right way or the conventional REACT way

// COMPLEX STATE!!- Many pieces of state or values or things that need to change their behaviours during the lifecycle of our app!!
// - We can use multiple useState function to create multiple separate "pieces" of state

// Example here- Creating 2 pieces of state - named Left, right
const App = () => {
  // first piece of state for left-> initialized to 0
  const [left, setLeft] = useState(0)
  // second piece of state for right-> initialized to 0
  const [right, setRight] = useState(0)
  return (
    <div>
      {left}
      {/* Event handler for the left state */}
      <button onClick={() => setLeft(left + 1)}>
        left
      </button>
      {/* Even handler for the right state */}
      <button onClick={() => setRight(right + 1)}>
        right
      </button>
      {right}
    </div>
  )
}

// 🥷✅IMPLEMENTING MULTIPLE STATES INTO AN OBJECT -> which turns it into ONE single piece of state
// We can also implement this functionality using an object- we can put multiple states into an object or one object like below
const App = () => {  
const [clicks, setClicks]= useState({
    // initial state for left state 
    left:0,
    // initial state for right state
    right:0
  })

  // Lets have the handler functions for each state
  // For the left
  const handleLeftClick=()=>{
    const newClicks={
      left:clicks.left+1,
      right:clicks.right
    }
    // now, change the state
    setClicks(newClicks)
  }
// For the right 
const handleRightClick=()=>{
    const newClicks={
      left:clicks.left,
      right:clicks.right+1
    }
    // now, change the state
    setClicks(newClicks)
  }
   return (
    <div>
      {clicks.left}
      <button onClick={handleLeftClick}>left</button>
      <button onClick={handleRightClick}>right</button>
      {clicks.right}
    </div>
  )
}

// When using the object on multiple piece of state, 
// We deploy "OBJECT SPREAD" - to make access the properties in the object we want easily accessible

// Lets change the handler functions - we used applied the object spread syntax !!
const handleLeftClick = () => {
  // The new object we want to be the state changed into
  const newClicks = { 
    // rest of the object
    ...clicks, 
    // We access only the property we want in an object, then do whatever we want with it
    left: clicks.left + 1 
  }
  setClicks(newClicks)
}

const handleRightClick = () => {
  const newClicks = { 
    ...clicks, 
    right: clicks.right + 1 
  }
  setClicks(newClicks)
}

// Another easier way to do this- is to even refactor the way we assign the object to a new variable in the event handler
// We can immediately just change the state with out assigning the object to a new variable as shown above
// First handler function for the left state
const handleLeftClick = () =>
  setClicks({ ...clicks, left: clicks.left + 1 })

// Second handler function for the right state 
const handleRightClick = () =>
  setClicks({ ...clicks, right: clicks.right + 1 })

// NB: ITS FORBIDDEN IN REACT TO MUTATE STATE DIRECTLY, SINCE IT CAN  RESULT IN UNEXPECTED SIDE EFFECTS
// Changing state has to always be done by setting the state to a NEW OBJECT, not by changing a single variable/value in the object -> That would be MUTATING OF STATE

// HANDLING ARRAYS 

// 1. Example 1
const App = () => {

  // First state
  const [left, setLeft] = useState(0)
  // Second state
  const [right, setRight] = useState(0)

  // State whose initial state is an array, an empty array
  const [allClicks, setAll] = useState([])

// 1st handler function for the left click
  const handleLeftClick = () => {
    // Changes the state of the array state by appending 'L' to the array
    setAll(allClicks.concat('L'))
    // change the state of the LEFT state
    setLeft(left + 1)
  }

// 2nd handler function for the Right click
  const handleRightClick = () => {
    // change the state of the array state by appending 'R' to the array
    // The concat function doesnt mutate the array but rather returns a new copy of the array with the new item added to it
    setAll(allClicks.concat('R'))
    // change the state of the Right state
    setRight(right + 1)
  }

  return (
    <div>
      {left}
      <button onClick={handleLeftClick}>left</button>
      <button onClick={handleRightClick}>right</button>
      {right}
{/* Now join all the elements in the array state and display them */}
      <p>{allClicks.join(' ')}</p>
    </div>
  )
}

// NB: NEVER MUTATE STATE, it seems to work in some cases but it can lead to problems that are hard to debug 

//🥷✅ UPDATE OF THE STATE IS ASYNCHRONOUS

// 2 . Example 2
const App = () => {
  // left state
  const [left, setLeft] = useState(0)
  // right state
  const [right, setRight] = useState(0)
  // The array state
  const [allClicks, setAll] = useState([])

  // total state, tracks how many times the buttons are clicked, general for all the states
  const [total, setTotal] = useState(0)

  // 1st handler function for the left click
  const handleLeftClick = () => {
    // update the array variable
    setAll(allClicks.concat('L'))
    // update the left variable
    setLeft(left + 1)
//  update the total variable
    setTotal(left + right)
  }

  // 2nd handler function for the Right click
  const handleRightClick = () => {
    // update the array variable 
    setAll(allClicks.concat('R'))
    // update the right variable
    setRight(right + 1)
// update the total variable
    setTotal(left + right)
  }

  return (
    <div>
      {left}
      <button onClick={handleLeftClick}>left</button>
      <button onClick={handleRightClick}>right</button>
      {right}
      <p>{allClicks.join(' ')}</p>

      <p>total {total}</p>
    </div>
  )
}

// In this code we will find that the state doesnt immediately update 
// because The reason for this is that a state update in React happens asynchronously, 
// i.e. not immediately but "at some point" before the component is rendered again.

// Fix is Down below for the above code 
  // ...
  const handleLeftClick = () => {
    setAll(allClicks.concat('L'))
    // update the state manually to stop delays in asynchronous way but immediately
    const updatedLeft = left + 1
    // Then pass the updated state into the set function to change the state of  the variable you want to change
    setLeft(updatedLeft)

    // This total variable will immediately change and bring correct results
    setTotal(updatedLeft + right) 
  }
 // ...

// 🥷✅ CONDITIONAL RENDERING 
// Lets modify our application so that the rendering of the clicking history is handled by a new History component
// Just like conditions  in our programming
const History = (props) => {
  // if the length of our array is 0 then we will display that message to our users
  if (props.allClicks.length === 0) {
    return (
      <div>
        the app is used by pressing the buttons
      </div>
    )
  }

  // This is what will be returned instead 
  return (
    <div>
      button press history: {props.allClicks.join(' ')}
    </div>
  )
}

const App = () => {
  // ...

  return (
    <div>
      {left}
      <button onClick={handleLeftClick}>left</button>
      <button onClick={handleRightClick}>right</button>
      {right}
  
  {/* Our component to show history of clicks  */}
      <History allClicks={allClicks} />
    </div>
  )
}


