//🥷✅ RULES of HOOKS 
// 1.Dont use hooks or call them from inside of a loop, a conditional expression, or any place
// that is not a function defining a component 
// Its done to ensure that the hooks are always called in the same order,
// if its not done in that case  the application will behave erratically

// HOOKS may only be called from inside of a function body that defines a react component

const App = () => {
  // these are ok
  const [age, setAge] = useState(0)
  const [name, setName] = useState('Juha Tauriainen')

  if ( age > 10 ) {
    // this does not work!
    // doesnt work because we are using a hook inside of a conditional expression
    const [foobar, setFoobar] = useState(null)
  }

  for ( let i = 0; i < age; i++ ) {
    // also this is not good
    // doesnt work because we are using a hook inside of a loop
    const [rightWay, setRightWay] = useState(false)
  }

  const notGood = () => {
    // and this is also illegal
    // doesnt work because we are using a hook inside of a function that doesnt return a react component 
    const [x, setX] = useState(-1000)
  }

  return (
    //...
  )
}

//🥷✅ EVENT HANDLING REVISITED 
// In order to make the button react to a click event, 
// we have to add an event handler to it.
// Event handlers must always be a function or a reference to a function
// The button will not work if the event handler is set to a variable or any other type
const App = () => {
    // state to change a variable, using the hook -> useState 
  const [value, setValue] = useState(10)

  return (
    <div>
        {/* The value */}
      {value}
      {/* event handler, the button element facilitates it */}
      <button>reset to zero</button>
    </div>
  )
}

// WHAT WILL NOT WORK 
<button onClick={console.log('clicked the button')}>
  button
</button>

// This will only display when the component is rendered by when its clicked the message wont be displayed on the console
// even though it contains a function because the event handler here is defined as a function call , which means 
// that the event handler is assigned the returned value from the function, which in the case of console.log is undefined.
// The console.log function call gets executed when the component is rendered and for this reason, it gets printed once to the console.

The following attempt is flawed as well:

<button onClick={setValue(0)}>button</button>

// REFERENCE TO THE ABOVE, we have assigned the event handler to a function call, which for this cause doesnt work 
// When the component is rendered , the function setValue(0) get executed which in turn causes the component to be re-rendered->
// Re-rendering in turn calls setValue(0) again, resulting in an INFINITE RECURSION

THE BEST PRACTICES ON EVENT HANDLING 
// Dont set function calls as event handlers-> We do set a function as the event handler not a function call

// Here is a good way or recommended way to do it 
<button onClick={() => console.log('clicked the button')}>
  button
</button>

// So when the component gets rendered, no function gets called immediately and the  only
// reference to the arrow function is set to the event handler, calling the function
// happens only once the button is clicked

// We can implement resetting the state in our application with this same technique:
<button onClick={() => setValue(0)}>button</button>

NB: DEFINING EVENT HANDLERS DIRECTLY IN THE ATTRIBUTE OF THE BUTTON IS NOT NECESSARILY 
THE BEST POSSIBLE IDEA

// YOU will see event handlers defined in a separate place, define a function that then gets assigned to the handleClick variable in the 
// body of the  component function

const App = () => {
  // State for the value variable
  const [value, setValue] = useState(10)

  // handler function that we will later assign to the event handler  in the component's body
  const handleClick = () =>
    // This what will happen when the event handler is clicked or some other 
    console.log('clicked the button')

  return (
    <div>
      {value}
      {/* Assign a function reference to the event handler  */}
      <button onClick={handleClick}>button</button>
    </div>
  )
}


// 🥷✅ A FUNCTION THAT RETURNS A FUNCTION 
// Another  WAY to define an event handler is to use a function that returns 
// a function 
// Its not that much need to use functions that return functions 

const App = () => {
  // state for the value variable 
  const [value, setValue] = useState(10)

  // This a handler function called hello 
  const hello = () => {
    // This function is inside the hello function 
    const handler = () => console.log('hello world')
    // This is what the hello function returns, which is a function
    // so hello is a function that returns a function 
    return handler
  }

  return (
    <div>
      {value}

      {/* We use the hello function reference assigned to our event handler  */}
      {/* We dont a sign it a function but a function call because the function call */}
      {/* returns a function thats trigged */}
      <button onClick={hello()}>button</button>
    </div>
  )
}
// MORE EXPLANATION 
<button onClick={hello()}>button</button>

// Earlier on we stated that an event handler may not be a call to a function and that it has to be a function or a reference to a function. 
// Why then does a function call work in this case?

<button onClick={() => console.log('hello world')}>
  button
</button>

// It assigns the return value of hello( ) to the onClick attribute which  is a function, 
// Since the hello function returns a function, the EVENT Handler is now a function 

// SO WHATS THE POINT OF THIS CONCEPT OF USING FUNCTION THAT RETURNS FUNCTION
BELOW HERE IS THE CODE TO EXPLAIN IT 👇

const App = () => {
  // state for the value variable
  const [value, setValue] = useState(10)


  // Functon that takes in an parameter of (who)
  const hello = (who) => {
    // A function inside a function called handler 
    const handler = () => {
      // it displays a message hello, the use the variable from its parent function
      // or the function it is inside of 
      console.log('hello', who)
    }
    // What the hello function returns , its a function inside it called handler 
    return handler
  }

  return (
    <div>
      {value}
{/* Using the function call, which returns a function */}
{/* We call it with some arguments because thats how we defined it in the first place  */}
      <button onClick={hello('world')}>button</button>
      <button onClick={hello('react')}>button</button>
      <button onClick={hello('function')}>button</button>
    </div>
  )
}

// AWESOME NOTE: NB:  FUNCTIONS RETURNING FUNCTIONS CAN BE UTILIZED IN DEFINING GENERIC 
// FUNCTIONALITY THAT CAN BE CUSTOMIZED WITH PARAMETERS
// FOR EXAMPLE (E.G)-> THe hello function that creates the event handlers can be thought of as a factory that produces customized event handlers meant for greeting users 

SINCE OUR CURRENT DEFINITION IS SLIGHTLY VERBOSE, WE CAN REFACTOR IT 

// THE VERBOSE FUNCTION 
const hello = (who) => {
  const handler = () => {
    console.log('hello', who)
  }

  return handler
}

// THE REFACTORED ONE 
const hello = (who) => {
  // anyways it returns a function so we dont need to give it any name even
  // let it return an anonymous function- but we make it return what we want
  return () => {
    console.log('hello', who)
  }
}


// WE CAN USE THE SAME TRICK TO DEFINE EVENT HANDLERS THAT SET THE STATE OF THE COMPONENT
// TO A GIVEN VALUE, EXAMPLE BELOW 👇
const App = () => {
  // STATE FOR THE VALUE VARIABLE 
  const [value, setValue] = useState(10)
  
// HANDLER FUNCTION, takes in a paramer
// IT RETURNS A FUNCTION
  const setToValue = (newValue) => () => {
    // consoles the value passed in as a parameter in the setToValue
    console.log('value now', newValue)  // print the new value to console
    // What this inner function does is to set the old value into a value 
    // thats is passed on to it from the parent function 
    setValue(newValue)
  }
  
  return (
    <div>
      {value}

{/* The 1st function call returns a function that changes the previous state into 1000 */}
      <button onClick={setToValue(1000)}>thousand</button>
      {/* The 2nd function call returns a function that resets the previous state to 0 */}
      <button onClick={setToValue(0)}>reset</button>
      {/* The 3rd function call returns a function that changes the previous state to be increment by 1 */}
      <button onClick={setToValue(value + 1)}>increment</button>
    </div>
  )
}

NOTE BELOW 👇
// Using functions that return functions is not required to achieve this functionality. 
// Let's return the setToValue function which is responsible for updating state into a normal function:

const App = () => {
  const [value, setValue] = useState(10)

  const setToValue = (newValue) => {
    console.log('value now', newValue)
    setValue(newValue)
  }

  return (
    <div>
      {value}
      <button onClick={() => setToValue(1000)}>
        thousand
      </button>
      <button onClick={() => setToValue(0)}>
        reset
      </button>
      <button onClick={() => setToValue(value + 1)}>
        increment
      </button>
    </div>
  )
}

// NB: Choosing between the two presented ways of defining your event handlers is mostly a matter of taste.


// 🥷✅ PASSING EVENT HANDLERS TO CHILD COMPONENTS-> FROM PARENT TO CHILD 
//  EXAMPELE BELOW 👇

// LET'S EXTRACT THE BUTTON INTO ITS OWN COMPONENT 

// Button component or function, it takes in props, lets call it parameter
const Button = (props) => (
  // Lets destruct the onClick function from the props Object 
  <button onClick={props.onClick}>
    {/* lets destruct the text element from the props object  */}
    {props.text}
  </button>
)

// Now lets use the button component inside the APP COMPONENT WHICH IS THE PARENT COMPONENT
// AND the button component will be the child so it will take its props fro m the parent or the APP COMPONENT 
const App = (props) => {
  // ...
  return (
    <div>
      {value}
{/*  */}
      <Button onClick={() => setToValue(1000)} text="thousand" />
      <Button onClick={() => setToValue(0)} text="reset" />
      <Button onClick={() => setToValue(value + 1)} text="increment" />
    </div>
  )
}

// 🥷✅ DO NOT DEFINE COMPONENTS WITHIN COMPONENTS 

// This is the right place to define a component
// Define a component outside and different ✅
const Button = (props) => (
  <button onClick={props.onClick}>
    {props.text}
  </button>
)

const App = () => {
  const [value, setValue] = useState(10)

  const setToValue = newValue => {
    console.log('value now', newValue)
    setValue(newValue)
  }

  // Do not define components inside another component ❌

  const Display = props => <div>{props.value}</div>

  return (
    <div>

      <Display value={value} /> ❌
      <Button onClick={() => setToValue(1000)} text="thousand" /> ✅
      <Button onClick={() => setToValue(0)} text="reset" /> ✅
      <Button onClick={() => setToValue(value + 1)} text="increment" /> ✅
    </div>
  )
}

 NOTE CAREFULLY (NB) 🙏✅// The application still appears to work, but don't implement components like this! 
// Never define components inside of other components. 
// The method provides no benefits and leads to many unpleasant problems.
//  The biggest problems are because React treats a component defined inside of another component as a new component in every render. 
// This makes it impossible for React to optimize the component.

